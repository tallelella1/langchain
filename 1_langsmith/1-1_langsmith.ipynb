    "# 是否启用Langsmith监控功能\n",
    "LANGSMITH_TRACING=true\n",
    "# Langsmith监控WebUI地址\n",
    "LANGSMITH_ENDPOINT=https://api.smith.LangChain.com\n",
    "# 创建的API_KEY\n",
    "LANGSMITH_API_KEY=<YOUR_API_KEY>\n",
    "# 自定义项目名称，可以在Langsmith WebUI监控页面根据名称查看对应的运行记录\n",
    "LANGSMITH_PROJECT=\"pr-clear-harmony-32\""
