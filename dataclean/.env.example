# Copy to .env and replace this value (python -c "import secrets; print(secrets.token_hex(32))").
DATACLEAN_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Local Windows demo. Docker Compose supplies PostgreSQL + Celery settings.
DATACLEAN_DATABASE_URL=sqlite:///./data/dataclean.db
DATACLEAN_TASK_BACKEND=local
DATACLEAN_STORAGE_DIR=./data/files
DATACLEAN_BROKER_URL=redis://localhost:6379/0
DATACLEAN_MAX_UPLOAD_BYTES=10485760
DATACLEAN_TOKEN_MINUTES=60
# A lease detects a lost worker, renewed every lease_seconds / 3.
DATACLEAN_LEASE_SECONDS=300
DATACLEAN_POLL_SECONDS=2
